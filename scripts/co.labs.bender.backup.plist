<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily off-site backup of the Robot.

  Install:  scripts/install-schedule.sh
  Status:   launchctl list | grep bender
  Run now:  launchctl kickstart -k gui/$(id -u)/co.labs.bender.backup
  Remove:   launchctl bootout gui/$(id -u)/co.labs.bender.backup

  Runs at 03:20 daily. RunAtLoad is false on purpose -- installing a backup
  job should not fire one immediately; the first scheduled run is the test
  that it works unattended. If the Mac is asleep at 03:20, launchd runs it
  at the next wake, so a closed lid does not silently skip a day.

  Failures are reported into the owner's chat by the script itself
  (robotd notify), not left in a log nobody reads.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>co.labs.bender.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT__/scripts/backup-offsite.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>20</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/bender-backup.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/bender-backup.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
